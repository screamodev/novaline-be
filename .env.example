# Server
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# Secrets — generate each with: openssl rand -base64 32
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL 16)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=novaline
DATABASE_USERNAME=novaline
DATABASE_PASSWORD=novaline
DATABASE_SSL=false

# Integrations
# Where Strapi sends the revalidate webhook (Docker service name in the dev/prod stacks)
FRONTEND_URL=http://web:3000
FRONTEND_REVALIDATE_SECRET=change-me
# Lead notifications (leave empty to disable). TELEGRAM_API_BASE is only overridden in tests.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# First-boot default locale
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=uk
