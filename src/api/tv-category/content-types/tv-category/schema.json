{
  "kind": "collectionType",
  "collectionName": "tv_categories",
  "info": {
    "singularName": "tv-category",
    "pluralName": "tv-categories",
    "displayName": "TV category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "key": {
      "type": "uid",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "channels": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tv-channel.tv-channel",
      "mappedBy": "category"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
