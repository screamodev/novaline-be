{
  "kind": "singleType",
  "collectionName": "careers_page",
  "info": {
    "singularName": "careers-page",
    "pluralName": "careers-pages",
    "displayName": "Careers page",
    "description": "Copy and HR contacts of the /vacancies page; the vacancies themselves are the Vacancy collection."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "sections.heading",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "benefitsTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "careers.benefit",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "listTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contactsTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contactsText": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hrName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hrPhone": {
      "type": "component",
      "repeatable": false,
      "component": "shared.phone",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "hrEmail": {
      "type": "email",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "hrTelegram": {
      "type": "string",
      "description": "Telegram username (@novaline_hr) or https://t.me/… link",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "emptyTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "emptyText": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
