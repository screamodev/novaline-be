{
  "kind": "collectionType",
  "collectionName": "settlements",
  "info": {
    "singularName": "settlement",
    "pluralName": "settlements",
    "displayName": "Settlement"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "nameLocative": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Locative case, e.g. \"у Пісочині\""
    },
    "lat": {
      "type": "float",
      "min": 44,
      "max": 53,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "lng": {
      "type": "float",
      "min": 22,
      "max": 41,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isRegionalCentre": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "district": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::district.district",
      "inversedBy": "settlements"
    },
    "neighbourhoods": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::neighbourhood.neighbourhood",
      "mappedBy": "settlement"
    },
    "offers": {
      "type": "component",
      "repeatable": true,
      "component": "coverage.offer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "description": "Connection terms at this locality (shared by both languages)"
    },
    "intro": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
