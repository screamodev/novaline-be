{
  "kind": "collectionType",
  "collectionName": "vacancies",
  "info": {
    "singularName": "vacancy",
    "pluralName": "vacancies",
    "displayName": "Vacancy",
    "description": "An open position on /vacancies. Unpublish to close it. Contacts left empty fall back to the Careers page HR contacts."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "key": {
      "type": "uid",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "city": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "department": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "employmentType": {
      "type": "enumeration",
      "enum": [
        "full-time",
        "part-time",
        "shift",
        "contract",
        "internship"
      ],
      "default": "full-time",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "workFormat": {
      "type": "enumeration",
      "enum": [
        "office",
        "field",
        "remote",
        "hybrid"
      ],
      "default": "office",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "salaryFrom": {
      "type": "integer",
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "salaryTo": {
      "type": "integer",
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "salaryLabel": {
      "type": "string",
      "description": "Shown instead of / after the numbers, e.g. «за домовленістю» or «+ бонуси»",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "isHot": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "summary": {
      "type": "text",
      "maxLength": 280,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "responsibilities": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "requirements": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "offer": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contactName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contactPhone": {
      "type": "string",
      "regex": "^\\+\\d{10,15}$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "contactTelegram": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
