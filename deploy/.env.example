# Stack-level settings for docker-compose.prod.yml (copy to deploy/.env).

# Public domains. Staging first; switch to novaline.net / cms.novaline.net at launch.
DOMAIN=dev.novaline.net
CMS_DOMAIN=cms.dev.novaline.net
# "production" enables indexing (robots/meta). Keep "staging" on dev.novaline.net.
SITE_ENV=staging

# Docker network of the existing Caddy container, e.g.:
#   docker inspect <caddy-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
CADDY_NETWORK=pasteria-be_default

# PostgreSQL (generate the password: openssl rand -base64 24)
DATABASE_NAME=novaline
DATABASE_USERNAME=novaline
DATABASE_PASSWORD=

# Backups (backup.sh)
BACKUP_DIR=/opt/novaline/backups
BACKUP_KEEP_DAYS=14
