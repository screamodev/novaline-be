DOMAIN=new.novaline.net
# "production" enables indexing; keep "staging" until launch.
SITE_ENV=staging
DATABASE_NAME=novaline
DATABASE_USERNAME=novaline
DATABASE_PASSWORD=
# Image tags (default: latest from GHCR)
# CMS_IMAGE=ghcr.io/screamodev/novaline-be:<sha>
# WEB_IMAGE=ghcr.io/screamodev/novaline-fe:<sha>
BACKUP_DIR=/opt/novaline/backups
BACKUP_KEEP_DAYS=14
